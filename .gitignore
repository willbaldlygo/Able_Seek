# =============================================================================
# Able2 .gitignore
# =============================================================================

# =============================================================================
# Secrets and Credentials - CRITICAL
# =============================================================================
.env
.env.local
.env.*.local
*.env

# API Keys
*.key
*.pem
*.p12
*.pfx

# Google OAuth credentials
config/*.json
config/*credentials*
config/*token*
*credentials*.json
*token*.json
gmail_credentials.json
gmail_token.json
calendar_credentials.json
calendar_token.json

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# =============================================================================
# IDE and Editors
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# =============================================================================
# Data and Storage
# =============================================================================
# Vector store data
Able2/data/
data/
*.db
*.sqlite
*.sqlite3

# Uploads (user files)
uploads/
Able2/uploads/

# Knowledge graph files (especially legacy pickle)
*.pkl
*.pickle
knowledge_graph.pkl

# Log files
*.log
logs/
Able2/logs/

# =============================================================================
# Docker
# =============================================================================
# Docker compose override (local settings)
docker-compose.override.yml
docker-compose.local.yml

# =============================================================================
# OS Files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================================================
# Temporary Files
# =============================================================================
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/

# =============================================================================
# Node.js (if frontend uses npm)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
