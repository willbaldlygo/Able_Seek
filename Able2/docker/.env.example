# =============================================================================
# Able2 Docker Environment Variables
# =============================================================================
# IMPORTANT: Copy this file to .env and set secure values before deploying!
# NEVER commit .env to version control.
# =============================================================================

# Database Configuration
# Generate a strong password: openssl rand -base64 32
POSTGRES_DB=able2
POSTGRES_USER=able2
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# API Keys
# Get your Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Able2 API Authentication
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# All API endpoints (except /health and /) require this key
# Pass via X-API-Key header or api_key query parameter
ABLE2_API_KEY=CHANGE_ME_GENERATE_A_SECURE_KEY

# Set to false to disable API key requirement (NOT recommended for production)
# API_KEY_ENABLED=true

# Optional: Google OAuth (for Phase 2 - Gmail/Calendar integration)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
