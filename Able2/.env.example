# Able2 Environment Configuration
# Copy this to .env and fill in your values

# ==============================================================================
# LLM Configuration
# ==============================================================================

# Anthropic API Key (required for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default LLM provider (anthropic or ollama)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ==============================================================================
# Database Configuration
# ==============================================================================

# PostgreSQL
DATABASE_URL=postgresql://able2:able2password@localhost:5432/able2
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# ==============================================================================
# Agent Configuration
# ==============================================================================

# Enable/disable agent system
AGENTS_ENABLED=true

# Orchestrator Agent
ORCHESTRATOR_MODEL=claude-3-5-sonnet-20241022
ORCHESTRATOR_PROVIDER=anthropic
ORCHESTRATOR_TEMPERATURE=0.7

# Memory Agent (uses Ollama for fast retrieval)
MEMORY_AGENT_MODEL=llama3.2
MEMORY_AGENT_PROVIDER=ollama
MEMORY_AGENT_TEMPERATURE=0.3

# Context Agent (Phase 2)
CONTEXT_AGENT_MODEL=llama3.2
CONTEXT_AGENT_PROVIDER=ollama

# Execution Agent (Phase 3)
EXECUTION_AGENT_MODEL=claude-3-5-sonnet-20241022
EXECUTION_AGENT_PROVIDER=anthropic

# ==============================================================================
# Autonomy Configuration
# ==============================================================================

# Default autonomy level (conservative, moderate, aggressive)
AUTONOMY_DEFAULT_LEVEL=moderate

# ==============================================================================
# Retrieval Configuration
# ==============================================================================

# Vector Search
RETRIEVAL_TOP_K=10
RETRIEVAL_SIMILARITY_THRESHOLD=0.7

# Reranking
RETRIEVAL_USE_RERANKING=true

# Chunking
RETRIEVAL_CHUNK_SIZE=1000
RETRIEVAL_CHUNK_OVERLAP=200

# Hybrid Search Weights
RETRIEVAL_BM25_WEIGHT=0.3
RETRIEVAL_VECTOR_WEIGHT=0.7

# ==============================================================================
# GraphRAG Configuration
# ==============================================================================

GRAPHRAG_ENABLED=true
GRAPHRAG_COMMUNITY_LEVELS=3
GRAPHRAG_MAX_TOKENS=8000

# ==============================================================================
# Integration Configuration (Phase 2/3)
# ==============================================================================

# Gmail
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_PATH=./config/gmail_credentials.json
GMAIL_TOKEN_PATH=./config/gmail_token.json

# Google Calendar
CALENDAR_ENABLED=false
CALENDAR_CREDENTIALS_PATH=./config/calendar_credentials.json
CALENDAR_TOKEN_PATH=./config/calendar_token.json

# SearxNG (Web Search)
SEARXNG_ENABLED=true
SEARXNG_URL=http://localhost:8080

# ==============================================================================
# File Paths
# ==============================================================================

PATH_VECTOR_STORE=./Able2/data/vector_store
PATH_GRAPH_STORE=./Able2/data/graph_store
PATH_UPLOADS=./Able2/data/uploads
PATH_LOGS=./Able2/logs
PATH_TEMP=./Able2/temp

# ==============================================================================
# API Configuration
# ==============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ==============================================================================
# Logging Configuration
# ==============================================================================

LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=./Able2/logs/able2.log

# ==============================================================================
# Feature Flags
# ==============================================================================

# Phase 1 features
FEATURE_MULTI_AGENT=true
FEATURE_DATABASE=true

# Phase 2 features
FEATURE_GMAIL=false
FEATURE_CALENDAR=false
FEATURE_MULTI_SOURCE_SEARCH=false

# Phase 3 features
FEATURE_WEB_BROWSING=false
FEATURE_CODE_EXECUTION=false
FEATURE_TASK_MANAGEMENT=false
